generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  COLLABORATOR
}

enum RecordType {
  PREVENTIVE
  CORRECTIVE
}

enum RecordStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  UNDER_VERIFICATION
  CLOSED
  CANCELLED
}

enum VerificationMethod {
  DOCUMENTAL
  VISUAL
  INTERVIEW
  OTHER
}

enum AttachmentSection {
  ROOT_CAUSE
  ACTION_PLAN
  EFFECTIVENESS
  ACKNOWLEDGEMENT
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(COLLABORATOR)
  position      String?
  authentikId   String?   @unique
  active        Boolean   @default(true)
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions            Session[]
  accounts            Account[]
  departments         DepartmentMember[]
  createdRecords      NonConformity[]    @relation("createdBy")
  verifiedRecords     NonConformity[]    @relation("effectivenessVerifiedBy")
  technicalSignatures NonConformity[]    @relation("technicalManager")
  generalSignatures   NonConformity[]    @relation("generalManager")
  assignedActions     Action[]
  acknowledgements    Acknowledgement[]
  attachments         Attachment[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Department {
  id               String   @id @default(cuid())
  name             String   @unique
  authentikGroupId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  members DepartmentMember[]
  records NonConformity[]
}

model DepartmentMember {
  userId       String
  departmentId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
}

model NonConformity {
  id       String       @id @default(cuid())
  year     Int
  sequence Int
  number   String       @unique
  type     RecordType
  status   RecordStatus @default(DRAFT)

  departmentId String

  problemDescription String
  problemDate        DateTime
  origin             String

  containmentAction String?
  rootCauseAnalysis String?

  verificationMethod       VerificationMethod?
  verificationMethodDetail String?

  effectivenessResult       String?
  effectivenessDate         DateTime?
  effectivenessVerifiedById String?

  technicalManagerId       String?
  technicalManagerSignedAt DateTime?
  generalManagerId         String?
  generalManagerSignedAt   DateTime?

  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  closedAt    DateTime?

  department              Department @relation(fields: [departmentId], references: [id])
  createdBy               User       @relation("createdBy", fields: [createdById], references: [id])
  effectivenessVerifiedBy User?      @relation("effectivenessVerifiedBy", fields: [effectivenessVerifiedById], references: [id])
  technicalManager        User?      @relation("technicalManager", fields: [technicalManagerId], references: [id])
  generalManager          User?      @relation("generalManager", fields: [generalManagerId], references: [id])

  actions          Action[]
  acknowledgements Acknowledgement[]
  attachments      Attachment[]

  @@unique([year, sequence])
  @@index([status])
  @@index([departmentId])
}

model Action {
  id              String    @id @default(cuid())
  nonConformityId String
  position        Int
  what            String
  who             String
  assigneeId      String?
  dueDate         DateTime
  where           String
  completedAt     DateTime?

  record   NonConformity @relation(fields: [nonConformityId], references: [id], onDelete: Cascade)
  assignee User?         @relation(fields: [assigneeId], references: [id])

  @@index([nonConformityId])
}

model Acknowledgement {
  id              String    @id @default(cuid())
  nonConformityId String
  userId          String?
  name            String
  position        String
  acknowledgedAt  DateTime?

  record NonConformity @relation(fields: [nonConformityId], references: [id], onDelete: Cascade)
  user   User?         @relation(fields: [userId], references: [id])

  @@unique([nonConformityId, userId])
}

model Attachment {
  id              String            @id @default(cuid())
  nonConformityId String
  section         AttachmentSection
  fileName        String
  mimeType        String
  size            Int
  objectKey       String            @unique
  uploadedById    String
  createdAt       DateTime          @default(now())

  record     NonConformity @relation(fields: [nonConformityId], references: [id], onDelete: Cascade)
  uploadedBy User          @relation(fields: [uploadedById], references: [id])

  @@index([nonConformityId])
}
