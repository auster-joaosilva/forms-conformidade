# Shared Postgres (DB Compartilhado > postgres, container "postgres" na rede shared-postgres)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=forms_conformidade
POSTGRES_USER=forms_conformidade
POSTGRES_PASSWORD=

# URL publica da aplicacao (usada pelo Better Auth como baseURL e trustedOrigin)
APP_URL=https://conformidade.auster.local

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# authentik | password
AUTH_MODE=authentik

# Authentik: Applications > Providers > OAuth2/OpenID > campo "OpenID Configuration Issuer"
AUTHENTIK_ISSUER_URL=https://auth.auster.local/application/o/forms-conformidade/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Authentik: Directory > Tokens & App passwords (token de um service account com view_user/view_group)
AUTHENTIK_API_TOKEN=

# Filtros do sync (listas separadas por virgula, `*` como curinga, sem case).
# Grupos: se o allowlist estiver preenchido, SO esses viram departamento;
# vazio = todos, menos o denylist.
AUTHENTIK_GROUP_ALLOWLIST=
AUTHENTIK_GROUP_DENYLIST=authentik *,forms-conformidade-*
# Usuarios: e-mails a ignorar. Service accounts e usuarios sem e-mail
# ja sao ignorados sempre.
AUTHENTIK_USER_DENYLIST=
# Atributo do Authentik/AD que carrega o departamento de fato. Quando presente,
# manda no lugar dos grupos (grupo de AD e grupo de acesso, nao departamento).
AUTHENTIK_DEPARTMENT_ATTRIBUTE=department

# Admin local de emergencia (tambem promovido a ADMIN na sincronizacao)
MASTER_USER_EMAIL=ti@austercontabil.com.br
MASTER_USER_PASSWORD=
MASTER_USER_NAME=Administrador

MAX_UPLOAD_BYTES=10485760

# MinIO (projeto MinIO > service, container "minio" na rede dokploy-network).
# Dentro do dokploy-network use o nome do container e HTTP; de fora, s3.auster.local com SSL.
S3_ENDPOINT=minio
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=forms-conformidade
BOOTSTRAP_ON_START=true

TZ=America/Sao_Paulo
# DNS interno para resolver auth.auster.local dentro do container
INTERNAL_DNS=10.10.30.242
# Certificados internos sao self-signed
NODE_TLS_REJECT_UNAUTHORIZED=0
